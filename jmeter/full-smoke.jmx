          <stringProp name="script">
if (vars.get("smokeUser") == null) {
    String uid = java.util.UUID.randomUUID().toString().substring(0, 8);
    vars.put("smokeUser", "jms_" + uid);
    vars.put("smokeEmail", "jms_" + uid + "@smoke.test");
}
