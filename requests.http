# You can use this file to easily send requests to your API.
# Prerequisite: humao.rest-client Vscode plugin (already present on codespace)
# High-level overview of REST API concepts used here: https://www.packtpub.com/en-us/learning/how-to-tutorials/what-are-rest-verbs-and-status-codes-tutorial

# TIP: Run requests in order - later requests reference IDs and tokens from earlier responses


# ==========================================
# Health Controller Endpoints
# ==========================================

### Health Check (no auth required)
GET http://localhost:8080/api/health


# ==========================================
# Authentication Endpoints
# ==========================================

### Sign up - create a new account
# @name signUp
POST http://localhost:8080/api/auth/signup
Content-Type: application/json

{
    "username": "jvaljean",
    "email": "prisoner24601@france.fr",
    "password": "password123"
}

### Sign in - authenticate and get JWT token
# @name signIn
POST http://localhost:8080/api/auth/signin
Content-Type: application/json

{
    "username": "jvaljean",
    "password": "password123"
}

### Sign in as admin
# @name signInAdmin
POST http://localhost:8080/api/auth/signin
Content-Type: application/json

{
    "username": "admin",
    "password": "admin"
}


# ==========================================
# User Controller Endpoints
# ==========================================

### Get own account (any authenticated user)
GET http://localhost:8080/api/users/me
Authorization: Bearer {{signIn.response.body.*}}

### Get all users (admin only)
GET http://localhost:8080/api/users
Authorization: Bearer {{signInAdmin.response.body.*}}

### Get user by ID (admin only)
GET http://localhost:8080/api/users/{{signUp.response.body.*}}
Authorization: Bearer {{signInAdmin.response.body.*}}

### Get user by email (admin only)
GET http://localhost:8080/api/users/by-email?email=prisoner24601@france.fr
Authorization: Bearer {{signInAdmin.response.body.*}}

### Change user name - PUT (admin only)
PUT http://localhost:8080/api/users/{{signUp.response.body.*}}
Content-Type: application/json
Authorization: Bearer {{signInAdmin.response.body.*}}

{
    "name": "Monsieur Madeleine"
}

### Change user name - PATCH (admin only)
PATCH http://localhost:8080/api/users/{{signUp.response.body.*}}/name
Content-Type: application/json
Authorization: Bearer {{signInAdmin.response.body.*}}

{
    "name": "Monsieur le Maire"
}


# ==========================================
# Cleanup (run these last)
# ==========================================

### Delete user (admin only)
DELETE http://localhost:8080/api/users/{{signUp.response.body.*}}
Authorization: Bearer {{signInAdmin.response.body.*}}
